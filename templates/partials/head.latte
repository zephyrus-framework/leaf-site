<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<meta name="leaf-base-url" content="{$leafBaseUrl}">

{* Favicons & PWA *}
<link rel="icon" type="image/png" href="{$leafBaseUrl}/assets/favicon/favicon-96x96.png" sizes="96x96">
<link rel="icon" type="image/svg+xml" href="{$leafBaseUrl}/assets/favicon/favicon.svg">
<link rel="shortcut icon" href="{$leafBaseUrl}/assets/favicon/favicon.ico">
<link rel="apple-touch-icon" sizes="180x180" href="{$leafBaseUrl}/assets/favicon/apple-touch-icon.png">
<meta name="apple-mobile-web-app-title" content="{$leafName ?? 'Leaf'}">
<link rel="manifest" href="{$leafBaseUrl}/assets/favicon/site.webmanifest">
<meta name="theme-color" content="#08080d">

{* Core SEO *}
{var $metaDesc = ($pageDescription ?? '') !== '' ? $pageDescription : ($leafDescription ?? '')}
{var $pageTitle = $title ?? ''}
{var $siteName = $leafName ?? ''}
{var $metaTitle = ($pageTitle === '' || $pageTitle === $siteName) ? $siteName : ($pageTitle . ' · ' . $siteName)}
{var $siteUrl = ($leafProductionUrl ?? '') !== '' ? $leafProductionUrl : $leafBaseUrl}
{var $isNotFound = $notFound ?? false}
{var $pagePath = isset($pagePath) ? $pagePath : (isset($section) && isset($slug) ? '/' . $section . '/' . $slug : '/')}
{var $canonicalUrl = $siteUrl . ($pagePath === '/' ? '/' : rtrim($pagePath, '/') . '/')}
{var $ogImageUrl = $siteUrl . '/assets/images/og-image.png'}

<title>{$metaTitle}</title>
<meta name="description" content="{$metaDesc}">
<meta name="author" content="{$leafAuthor ?? ''}">
{if $isNotFound}
<meta name="robots" content="noindex">
{else}
<meta name="robots" content="index, follow">
<link rel="canonical" href="{$canonicalUrl}">
{/if}

{* Open Graph *}
{if !$isNotFound}
<meta property="og:type" content="{$pagePath === '/' ? 'website' : 'article'}">
{/if}
<meta property="og:site_name" content="{$leafName ?? ''}">
<meta property="og:title" content="{$metaTitle}">
<meta property="og:description" content="{$metaDesc}">
{if !$isNotFound}
<meta property="og:url" content="{$canonicalUrl}">
{/if}
<meta property="og:image" content="{$ogImageUrl}">
<meta property="og:image:width" content="1200">
<meta property="og:image:height" content="630">
<meta property="og:image:alt" content="{$leafName ?? 'Zephyrus Leaf'}: static sites, quietly crafted.">
<meta property="og:locale" content="{$currentLocale ?? 'en'}">

{* Twitter / X *}
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content="{$metaTitle}">
<meta name="twitter:description" content="{$metaDesc}">
<meta name="twitter:image" content="{$ogImageUrl}">
<meta name="twitter:image:alt" content="{$leafName ?? 'Zephyrus Leaf'}: static sites, quietly crafted.">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet">
<script src="https://cdn.tailwindcss.com"></script>
<script>
tailwind.config = {
    theme: {
        extend: {
            colors: {
                deep: 'var(--bg-deep)',
                surface: 'var(--bg-surface)',
                elevated: 'var(--bg-elevated)',
                border: 'var(--border)',
                'border-accent': 'var(--border-accent)',
                body: 'var(--text)',
                bright: 'var(--text-bright)',
                muted: 'var(--text-muted)',
                accent: 'var(--accent)',
                'accent-light': 'var(--accent-light)',
                'accent-glow': 'var(--accent-glow)',
            },
            fontFamily: {
                body: ['Inter', 'system-ui', '-apple-system', 'sans-serif'],
                mono: ['JetBrains Mono', 'Fira Code', 'monospace'],
            },
        },
    },
}
</script>
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/prism/1.29.0/themes/prism-tomorrow.min.css">
<link rel="stylesheet" href="{$leafBaseUrl}/assets/css/app.css">
<script src="{$leafBaseUrl}/assets/js/theme.js"></script>
{if defined('DEV_SERVER')}
<script>
(function() {
    let lastHash = null;
    async function check() {
        try {
            const r = await fetch('/__dev/reload');
            const d = await r.json();
            if (lastHash && d.hash !== lastHash) location.reload();
            lastHash = d.hash;
        } catch(e) {}
    }
    check();
    setInterval(check, 1500);
})();
</script>
{/if}
